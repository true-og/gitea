#!/bin/sh
# Write the git.trueog.net homepage's live statistics into a tiny stylesheet, so the page shows current
# counts with no JavaScript. Installed to /usr/local/sbin by install-custom-templates.sh and run as the
# gitea user every 5 minutes from /etc/cron.d/gitea-homepage-stats. The landing page links the file with
# a per-minute ?t= version, so Cloudflare's and browsers' 6-hour asset caches never serve stale counts.
# On any failure it keeps the previous file instead of writing bad numbers.
#   API and OUT can be overridden for testing.
set -eu
API=${API:-http://127.0.0.1:3000/api/v1}
OUT=${OUT:-/opt/gitea/custom/public/assets/css/trueog-stats.css}

count() {
	n=$(curl -fsS -m 10 -o /dev/null -D - "$API/$1" | tr -d '\r' |
		sed -n 's/^[Xx]-[Tt]otal-[Cc]ount: *\([0-9][0-9]*\)$/\1/p')
	[ -n "$n" ] || { echo "gitea-homepage-stats: no X-Total-Count from $1" >&2; exit 1; }
	echo "$n"
}

# Public repositories of one organization, or 0 when it does not exist.
org_count() {
	hdr=$(curl -sS -m 10 -o /dev/null -D - "$API/orgs/$1/repos?limit=1" | tr -d '\r')
	status=$(printf '%s\n' "$hdr" | sed -n '1s/^HTTP\/[0-9.]* \([0-9][0-9]*\).*/\1/p')
	case "$status" in
	404) echo 0 ;;
	200)
		n=$(printf '%s\n' "$hdr" | sed -n 's/^[Xx]-[Tt]otal-[Cc]ount: *\([0-9][0-9]*\)$/\1/p')
		[ -n "$n" ] || { echo "gitea-homepage-stats: no X-Total-Count for organization $1" >&2; exit 1; }
		echo "$n" ;;
	*) echo "gitea-homepage-stats: HTTP ${status:-none} for organization $1" >&2; exit 1 ;;
	esac
}

# The "upstream" organization holds read-only pull mirrors of the projects TrueOG and
# NotAlexNoyle repositories are forked from, so forks can sync in the web interface. They are not
# TrueOG repositories, so the homepage count leaves them out.
all_repos=$(count 'repos/search?limit=1')
upstream_mirrors=$(org_count upstream)
repos=$((all_repos - upstream_mirrors))
# Only open pull requests and open issues are counted. The mirrors have pull requests and issues switched
# off, but anything of theirs is subtracted explicitly rather than relying on that. Gitea answers 400 for
# an unknown owner, so those queries only run while the organization exists.
open=$(count 'repos/issues/search?type=pulls&state=open&limit=1')
issues=$(count 'repos/issues/search?type=issues&state=open&limit=1')
if [ "$upstream_mirrors" -gt 0 ]; then
	open=$((open - $(count 'repos/issues/search?type=pulls&state=open&owner=upstream&limit=1')))
	issues=$((issues - $(count 'repos/issues/search?type=issues&state=open&owner=upstream&limit=1')))
fi

tmp=$(mktemp "$OUT.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cat >"$tmp" <<EOF
/* Generated by gitea-homepage-stats at $(date -u '+%Y-%m-%d %H:%M UTC'); do not edit. */
.trueog-stat-repos::before { content: "$repos"; }
.trueog-stat-pulls::before { content: "$open"; }
.trueog-stat-issues::before { content: "$issues"; }
EOF
chmod 644 "$tmp"
mv "$tmp" "$OUT"
trap - EXIT
